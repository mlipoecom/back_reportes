				{
					"name": "crear-usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData;\r",
									"try {\r",
									"    jsonData = pm.response.json();\r",
									"} catch (e) {\r",
									"    jsonData = null;\r",
									"}\r",
									"\r",
									"function extractId(obj) {\r",
									"    if (!obj || typeof obj !== 'object') return undefined;\r",
									"    if (obj.id !== undefined) return obj.id;\r",
									"    if (obj.data && obj.data.id !== undefined) return obj.data.id;\r",
									"    if (obj.result && obj.result.id !== undefined) return obj.result.id;\r",
									"    return undefined;\r",
									"}\r",
									"\r",
									"const id = extractId(jsonData);\r",
									"let validId = false;\r",
									"if (typeof id === 'number' && isFinite(id)) {\r",
									"    pm.collectionVariables.set('userId', id);\r",
									"    validId = true;\r",
									"} else if (typeof id === 'string' && id.trim().length > 0) {\r",
									"    pm.collectionVariables.set('userId', id);\r",
									"    validId = true;\r",
									"}\r",
									"\r",
									"pm.test('Response status is 2xx', function () {\r",
									"    pm.expect(pm.response.code).to.be.within(200, 299);\r",
									"});\r",
									"pm.test('Identifier (id) was found and valid', function () {\r",
									"    pm.expect(validId, 'A valid id was found in the response').to.be.true;\r",
									"});\r",
									"\r",
									"if (validId) {\r",
									"    console.log('userId set to:', id);\r",
									"} else {\r",
									"    console.log('userId was not set. Response body:', jsonData);\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
