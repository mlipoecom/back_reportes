								"exec": [
									"let jsonData;",
									"let token;",
									"",
									"// 1. Parse JSON response safely",
									"try {",
									"    jsonData = pm.response.json();",
									"} catch (e) {",
									"    jsonData = {};",
									"    console.error('Response is not valid JSON:', e);",
									"}",
									"",
									"// 2. Extract token property with fallback",
									"if (jsonData) {",
									"    token = jsonData.accessToken || jsonData.token || jsonData.access_token;",
									"}",
									"",
									"// 3. Set collection variable if token found",
									"if (token) {",
									"    pm.collectionVariables.set('token', token);",
									"}",
									"",
									"// 4. Assertions",
									"pm.test('Response status code is 2xx', function () {",
									"    pm.expect(pm.response.code).to.be.within(200, 299);",
									"});",
									"pm.test('Token is present in response', function () {",
									"    pm.expect(token, 'Token should be present in response').to.exist;",
									"});",
									"",
									"// 5. Log helpful message",
									"if (token) {",
									"    console.log('Token extracted and set as collection variable:', token);",
									"} else {",
									"    console.warn('No token found in response. Check property names (accessToken, token, access_token).');",
									"}",
									""
								],
